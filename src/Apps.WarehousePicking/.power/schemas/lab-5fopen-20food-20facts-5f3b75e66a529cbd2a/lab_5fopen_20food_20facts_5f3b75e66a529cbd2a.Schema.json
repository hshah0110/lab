      "host": "2325824d01f9e42598252122c7bb26.04.environment.api.powerplatform.com",
      "basePath": "/connectors/runtime/invoke/scalegroups/usa002/shards/07/apis/lab-5fopen-20food-20facts-5f3b75e66a529cbd2a/connections/",
