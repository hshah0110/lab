      ],
      "consumes": [],
      "produces": [
        "application/json"
      ],
      "paths": {
        "/{connectionId}/product/{barcode}.json": {
          "get": {
            "summary": "Get product by barcode",
            "operationId": "GetProductByBarcode",
            "x-ms-visibility": "important",
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
              {
                "name": "barcode",
                "in": "path",
                "required": true,
                "type": "string",
                "x-ms-summary": "Barcode"
              }
            ],
            "responses": {
              "200": {
                "description": "Product found",
                "schema": {
                  "$ref": "#/definitions/Product"
                }
              },
              "404": {
                "description": "No product found for this barcode",
                "schema": {
                  "$ref": "#/definitions/Error"
                }
              }
            }
          }
        },
        "/{connectionId}/product-image": {
          "get": {
            "summary": "Get product image",
            "operationId": "GetProductImage",
            "x-ms-visibility": "important",
            "parameters": [
              {
                "name": "connectionId",
                "in": "path",
                "required": true,
                "x-ms-visibility": "internal",
                "type": "string"
              },
              {
                "name": "imageUrl",
                "in": "query",
                "required": true,
                "type": "string",
                "x-ms-summary": "Image URL"
              }
            ],
            "produces": [
              "image/jpeg",
              "image/png"
            ],
            "responses": {
              "200": {
                "description": "Image bytes",
                "schema": {
                  "type": "file"
                }
              },
              "400": {
                "description": "Image URL is required",
                "schema": {
                  "$ref": "#/definitions/Error"
                }
              }
            },
            "x-ms-media-kind": "image"
          }
        }
      },
